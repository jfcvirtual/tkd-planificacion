{
  "name": "Plan de entrenamiento TKD",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install -r requirements.txt pytest",
  "postAttachCommand": "streamlit run app.py --server.enableCORS false --server.enableXsrfProtection false",
  "forwardPorts": [8501],
  "portsAttributes": {"8501": {"label": "App TKD", "onAutoForward": "openPreview"}},
  "customizations": {"vscode": {"extensions": ["ms-python.python"]}}
}
